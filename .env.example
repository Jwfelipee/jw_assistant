# Copy to .env and adjust values. Do not commit real secrets.
#
# Local (host processes): DATABASE_URL uses localhost.
# Docker Compose: services talk to `db` on the internal network
# (compose overrides DATABASE_URL for api/migrate).

# PostgreSQL
POSTGRES_USER=jw
POSTGRES_PASSWORD=jw
POSTGRES_DB=jw_assistant
DATABASE_URL=postgresql://jw:jw@localhost:5432/jw_assistant?schema=public

# Single admin user (seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# Optional: precomputed bcrypt hash (skips hashing ADMIN_PASSWORD)
# ADMIN_PASSWORD_HASH=
CONGREGATION_NAME=Congregação (placeholder)
MEETING_WEEKDAY=THURSDAY

# Auth session secret (must match between API and Web middleware)
JWT_SECRET=change-me-to-a-long-random-string

# Nest API
PORT=3001
WEB_ORIGIN=http://localhost:3000
# false for local HTTP (Docker/dev); true behind HTTPS
COOKIE_SECURE=false

# Next.js — browser calls same-origin /api; rewrite proxies to API
API_ORIGIN=http://localhost:3001
# In Docker Compose, web build/runtime uses http://api:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api
