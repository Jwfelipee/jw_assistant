{
  "name": "jw-assistant",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @jw/database db:migrate",
    "db:migrate:dev": "pnpm --filter @jw/database db:migrate:dev",
    "db:seed": "pnpm --filter @jw/database db:seed",
    "db:generate": "pnpm --filter @jw/database db:generate",
    "db:validate": "pnpm --filter @jw/database db:validate",
    "docker:up": "bash scripts/docker.sh up",
    "docker:up:build": "bash scripts/docker.sh up:build",
    "docker:down": "bash scripts/docker.sh down",
    "docker:ps": "bash scripts/docker.sh ps",
    "docker:logs": "bash scripts/docker.sh logs",
    "docker:logs:web": "bash scripts/docker.sh logs web",
    "docker:logs:api": "bash scripts/docker.sh logs api",
    "docker:build": "bash scripts/docker.sh build",
    "docker:build:web": "bash scripts/docker.sh build web",
    "docker:build:api": "bash scripts/docker.sh build api",
    "docker:build:api:web": "bash scripts/docker.sh build api web",
    "docker:migrate": "bash scripts/docker.sh migrate",
    "build:docker": "bash scripts/docker.sh up:build",
    "build:web": "bash scripts/docker.sh redeploy web",
    "build:api": "bash scripts/docker.sh redeploy api",
    "build:api:web": "bash scripts/docker.sh redeploy api web"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
